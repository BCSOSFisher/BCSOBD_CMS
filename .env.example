# ---- Discord application (https://discord.com/developers/applications) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URL in the Discord app's OAuth2 settings
DISCORD_REDIRECT_URI=https://your-app.up.railway.app/auth/discord/callback
# Right-click your server icon -> Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=

# ---- Role IDs (right-click role -> Copy Role ID). Comma-separate multiple roles. Highest rank wins. ----
# Department Administration (Sheriff, Undersheriff, ...) — top rank, full command. Comma-separate multiple role IDs.
ROLE_ADMIN=
ROLE_BUREAU_LEAD=
ROLE_CO_LEAD=
ROLE_SUPERVISOR=
ROLE_LEAD=
ROLE_DET2=
ROLE_DET1=
ROLE_TRAINEE=
# Base Detective Bureau role — people with ONLY this role get view-only access
ROLE_BASE=

# ---- Unit membership roles (optional) — shown on the roster and used to pre-select the division on new cases ----
# Format: UNIT_ROLE_<division id from shared/config.json>=roleId
UNIT_ROLE_HOM=
UNIT_ROLE_GNU=
UNIT_ROLE_VICE=

# ---- Server ----
# Long random string; changing it signs everyone out
SESSION_SECRET=
# Where the database and uploaded media are stored (mount a persistent volume here)
DATA_DIR=/data
# First case number to use (e.g. 54 to continue after your existing #53)
CASE_NUMBER_START=54
# Max size of a single uploaded file (MB)
MAX_UPLOAD_MB=500
# Max number of uploads per case file
MAX_FILES_PER_CASE=15
# Optional total cap across all cases (MB). Leave unset for no total cap.
# MEDIA_LIMIT_MB=
NODE_ENV=production
# NEVER set this on the live site — it allows signing in without Discord
DEV_LOGIN=false
# Discord user IDs (comma-separated) allowed to download backups, in addition to Department Administration and the Bureau Lead
BACKUP_DISCORD_IDS=
